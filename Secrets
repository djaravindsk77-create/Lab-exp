
name: Secrets Demo

on:
  push:
    branches: ["main"]
  workflow_dispatch:

jobs:
  use-secret:
    runs-on: ubuntu-latest

    steps:
      - name: Check secret availability
        env:
          API_KEY: ${{ secrets.API_KEY }}
        run: |
          if [ -n "$API_KEY" ]; then
            echo "Secret is configured and available."
          else
            echo "Secret is missing."
            exit 1
          fi
